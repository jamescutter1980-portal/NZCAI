# Copy to .env and adjust. Compose reads .env automatically.

# stdio | http
NZCAI_MCP_TRANSPORT=http
NZCAI_MCP_HOST=0.0.0.0
NZCAI_MCP_PORT=8080

# Where mounted reference datasets are read from inside the container.
NZCAI_DATA_DIR=/data

# Comma-separated Host header allowlist for the HTTP transport (DNS-rebinding
# protection). A ":*" suffix allows any port. Leave unset ONLY while the port is
# confined to loopback or the compose network.
NZCAI_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# Comma-separated Origin header allowlist, for browser-based clients.
# NZCAI_MCP_ALLOWED_ORIGINS=https://portal.example.com
