# n3rgy data platform (https://data.n3rgy.com). Never commit the real key.
# Copy to .env.local and fill in.
N3RGY_API_KEY=
# sandbox | live
N3RGY_ENV=sandbox
# Optional override; defaults to the host for N3RGY_ENV.
# N3RGY_BASE_URL=https://api.data.n3rgy.com

# Consent store (development). Defaults to data/consents.json; use a database before multi-user deployment.
# CONSENT_STORE_PATH=data/consents.json

# Portal database (SQLite via Node's built-in driver). Default data/portal.sqlite.
# DB_PATH=data/portal.sqlite
# Bearer token that schedulers send to POST /api/n3rgy/sync. Leave unset on a local machine.
# SYNC_TOKEN=
# HTTP Basic Auth for the whole portal as user:password. Leave unset on a local machine.
# PORTAL_BASIC_AUTH=

# Name of the client organisation, used in the data requests drafted on the Value chain pages.
# CLIENT_NAME=
