# Portal (Next.js). Copy to .env.local and fill in.

# n3rgy data platform (https://data.n3rgy.com). Never commit the real key.
N3RGY_API_KEY=
# sandbox | live
N3RGY_ENV=sandbox
# Optional override; defaults to the host for N3RGY_ENV.
# N3RGY_BASE_URL=https://api.data.n3rgy.com

# Consent store (development). Defaults to data/consents.json; use a database before multi-user deployment.
# CONSENT_STORE_PATH=data/consents.json

# Portal database (SQLite via Node's built-in driver). Default data/portal.sqlite.
# DB_PATH=data/portal.sqlite
# Bearer token that schedulers send to POST /api/n3rgy/sync. Leave unset on a local machine.
# SYNC_TOKEN=
# HTTP Basic Auth for the whole portal as user:password. Leave unset on a local machine.
# PORTAL_BASIC_AUTH=

# Name of the client organisation, used in the data requests drafted on the Value chain pages.
# CLIENT_NAME=

# ---------------------------------------------------------------------------
# MCP layer (nzcai-mcp). Copy to .env; docker compose reads it automatically.

# stdio | http
NZCAI_MCP_TRANSPORT=http
NZCAI_MCP_HOST=0.0.0.0
NZCAI_MCP_PORT=8080

# Where mounted reference datasets are read from inside the container.
NZCAI_DATA_DIR=/data

# Where published reference tables live -- the DESNZ conversion factor flat file
# in particular, read from <REFERENCE_DATA_DIR>/desnz-conversion-factors/<year>.csv,
# and CRREM pathways from <REFERENCE_DATA_DIR>/crrem-pathways/<version>.csv.
# Shared with the portal, which reads the same variable. Defaults to
# <NZCAI_DATA_DIR>/reference. See docs/integrations/reference-data.md.
# REFERENCE_DATA_DIR=data/reference

# Comma-separated Host header allowlist for the HTTP transport (DNS-rebinding
# protection). A ":*" suffix allows any port. Leave unset ONLY while the port is
# confined to loopback or the compose network.
NZCAI_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# Comma-separated Origin header allowlist, for browser-based clients.
# NZCAI_MCP_ALLOWED_ORIGINS=https://portal.example.com

# Shared bearer token for the MCP HTTP transport. Callers send it as
# "Authorization: Bearer <token>". At least 32 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The HTTP transport refuses to start without this. The stdio transport ignores
# it entirely -- the client spawns the process, so there is no network to guard.
NZCAI_MCP_AUTH_TOKEN=

# Escape hatch: set to true to run the HTTP transport with no authentication.
# Only for a port genuinely confined to a trusted network. Logs a warning.
# NZCAI_MCP_ALLOW_ANONYMOUS=true
