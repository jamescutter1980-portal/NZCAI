# ---- Database -------------------------------------------------------------
# Local dev via docker-compose (see README):
DATABASE_URL=postgresql://nzcai:nzcai@localhost:5432/nzcai

# ---- Google Maps Platform -------------------------------------------------
# Browser key. Restrict by HTTP referrer + restrict to: Maps JavaScript API,
# Places API (New). Safe to expose - NEXT_PUBLIC_ vars ship to the client.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Set only if you want cloud-based map styling. Create under
# Google Cloud Console -> Google Maps Platform -> Map management. The map
# works fine without it.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server-side key. Restrict by IP + restrict to: Geocoding API, Solar API,
# Maps Static API. Never prefix this with NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_KEY=

# ---- Ingestion ------------------------------------------------------------
# Max records pulled per dataset per run. Raise once slugs are verified.
GRID_INGEST_PAGE_LIMIT=100
