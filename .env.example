# ---- Database -------------------------------------------------------------
# Local dev via docker-compose (see README):
DATABASE_URL=postgresql://nzcai:nzcai@localhost:5432/nzcai

# ---- Base map (MapLibre) --------------------------------------------------
# Ordnance Survey Data Hub key, for the OS Vector Tile API. Recommended for
# production: OS is the authoritative UK basemap and the same key serves the
# OS bulk products S-01 needs. Without it the map falls back to CARTO raster
# tiles, which is fine for development.
# Get one at https://osdatahub.os.uk -> API key -> OS Maps API / OS Vector Tiles
NEXT_PUBLIC_OS_MAPS_API_KEY=

# ---- Google Maps Platform -------------------------------------------------
# Google is NOT the base map (see docs/site-intel/PLAN.md 3.2). These are for
# the Solar API roof analysis and static map images in reports.
# Browser key: restrict by HTTP referrer, restrict to Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side key. Restrict by IP + restrict to: Geocoding API, Solar API,
# Maps Static API. Never prefix this with NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_KEY=

# ---- Ingestion ------------------------------------------------------------
# Max records pulled per dataset per run. Raise once slugs are verified.
GRID_INGEST_PAGE_LIMIT=100
