# ---- Database -------------------------------------------------------------
# Local dev via docker-compose (see README):
DATABASE_URL=postgresql://nzcai:nzcai@localhost:5432/nzcai

# ---- Base map (MapLibre) --------------------------------------------------
# Ordnance Survey Data Hub key, for the OS Vector Tile API. Recommended for
# production: OS is the authoritative UK basemap and the same key serves the
# OS bulk products S-01 needs. Without it the map falls back to CARTO raster
# tiles, which is fine for development.
# Get one at https://osdatahub.os.uk -> API key -> OS Maps API / OS Vector Tiles
NEXT_PUBLIC_OS_MAPS_API_KEY=

# ---- Google Maps Platform -------------------------------------------------
# Google is NOT the base map and NOT a coordinate source. MapLibre draws the map
# (see the base map block above); stored coordinates always come from OS Open
# UPRN, which `assertNoGoogleCoordinates` enforces. Brief 3.1, PLAN.md 3.2.
#
# Both keys are kept deliberately. One is wired, one is reserved - and the
# difference matters, because a blank key here should not read as a missing
# dependency. `npm run site:verify` prints the same distinction.

# LIVE, and optional. The last step of the resolution chain: geocode an address
# the EPC register could not match, then claim OS Open UPRN points within 25 m
# of the result. The Google coordinate is used to look up neighbours and then
# thrown away - it is never persisted. Leave it blank and the chain still works;
# it just stops at the postcode centroid for those addresses.
# Restrict by IP, and to the Geocoding API alone: the Solar API roof analysis
# and static report images are planned for this key but not built, so granting
# them now would widen the key ahead of anything that calls it.
# Never prefix this with NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_KEY=

# RESERVED. No code reads this yet. Held for Places autocomplete in the address
# box, which is not built. Leave it blank until it is.
# When it is used: restrict by HTTP referrer, and to Places API (New) alone.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Ingestion ------------------------------------------------------------
# Max records pulled per dataset per run. Raise once slugs are verified.
GRID_INGEST_PAGE_LIMIT=100

# ---- EPC register (Task 0) ------------------------------------------------
# Free. Register at https://epc.opendatacommunities.org/login-or-register
# These make `exact` matches possible: without them no address resolves through
# the register, and ownership and VOA matching stays postcode-only.
EPC_API_EMAIL=
EPC_API_KEY=
# Host. Defaults to the new one; set to https://epc.opendatacommunities.org to
# fall back to the legacy host. See PRELAUNCH.md TICKET-01.
EPC_API_BASE=

# ---- Companies House (S-04) -----------------------------------------------
# Free. https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# ---- Overrides for testing and offline work -------------------------------
# Point the constraints client at a fixture server.
PLANNING_DATA_BASE=
# Skip the Environment Agency flood cross-check (an unreachable EA is reported
# as unconfirmed either way, never as an all-clear).
EA_FLOOD_DISABLED=
# Environment Agency Flood Map for Planning service URL. The default path is
# unverified - see docs/site-intel/PLAN.md.
EA_FLOOD_SERVICE_URL=

