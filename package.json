{
  "name": "nzcai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/ingest/migrate.ts",
    "db:seed": "tsx src/ingest/seed.ts",
    "grid:verify": "tsx src/ingest/run.ts verify",
    "grid:ingest": "tsx src/ingest/run.ts ingest",
    "maplibre:worker": "node scripts/copy-maplibre-worker.mjs",
    "predev": "npm run maplibre:worker",
    "prebuild": "npm run maplibre:worker",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "site:verify": "tsx src/ingest/site.ts verify",
    "site:load-uprn": "tsx src/ingest/site.ts load-uprn",
    "site:postcodes": "tsx src/ingest/site.ts postcodes",
    "site:load-ccod": "tsx src/ingest/site.ts load-ccod",
    "site:load-voa": "tsx src/ingest/voa-load.ts",
    "epc:verify": "tsx src/ingest/epc-verify.ts",
    "epc:load": "tsx src/ingest/epc-load.ts",
    "grid:boundaries": "tsx src/ingest/dno-boundaries.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.9.0",
    "next": "^16.3.5",
    "pg": "8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "yaml": "^2.6.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "tsx": "^4.23.13",
    "typescript": "5.7.2"
  }
}
